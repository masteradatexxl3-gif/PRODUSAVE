# ============================================================================
# PRODUSAVE - Variables de entorno para Vercel / GitHub
# ============================================================================
# Copiá este archivo como .env y completá con tus credenciales reales de Supabase.
# En Vercel, cargá estas mismas variables en Project Settings → Environment Variables.

# URL del proyecto Supabase (encontrala en Project Settings → API)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Anon Key pública de Supabase (encontrala en Project Settings → API)
VITE_SUPABASE_ANON_KEY=TU-ANON-KEY-AQUI
